<UserControl
    x:Class="Calculator.Views.Patients.CorrectedAgeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:patients="clr-namespace:Calculator.ViewModel.ViewModels.Patients;assembly=Calculator.ViewModel"
    d:DataContext="{d:DesignInstance patients:CorrectedAgeViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Width="600" Height="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Margin="8" Text="矫正年龄计算：" FontWeight="Bold" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="8"
            VerticalAlignment="Center"
            Text="出生日期：" />
        <DatePicker
            Grid.Row="1"
            Grid.Column="1"
            Margin="8"
            VerticalAlignment="Center"
            VerticalContentAlignment="Bottom"
            materialDesign:TextFieldAssist.HasClearButton="True"
            FontSize="20"
            SelectedDate="{Binding Birthday}"
            Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
        <TextBlock
            Grid.Row="2"
            VerticalAlignment="Center"
            Grid.Column="0"
            Margin="8"
            Text="计算日期：" />
        <DatePicker
            Grid.Row="2"
            Grid.Column="1"
            Margin="8"
            VerticalAlignment="Center"
            VerticalContentAlignment="Bottom"
            materialDesign:TextFieldAssist.HasClearButton="True"
            FontSize="20"
            SelectedDate="{Binding Now}"
            Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            VerticalAlignment="Center"
            Margin="8"
            Text="填写孕周：" />

        <StackPanel
            Grid.Row="3"
            Grid.Column="1"
            Orientation="Horizontal">
            <ComboBox
                Margin="8"
                Width="120"
                ItemsSource="{Binding WeekSource}"
                SelectedItem="{Binding SelectedWeeks}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="4" Text="{Binding .}" VerticalAlignment="Center" />
                            <TextBlock Margin="0 4 4 4" Text="周" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox
                Width="120"
                Margin="8"
                ItemsSource="{Binding DaySource}"
                SelectedItem="{Binding SelectedDays}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="4" Text="{Binding .}" VerticalAlignment="Center" />
                            <TextBlock Margin="0 4 4 4" Text="天" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Button
            Grid.Row="4"
            Grid.Column="0"
            Width="100"
            HorizontalAlignment="Left"
            Command="{Binding CalcCommand}"
            Content="计算" />

        <TextBlock
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="8"
            VerticalAlignment="Center"
            Foreground="Green"
            FontSize="20"
            Text="{Binding CorrectedAge}" />
    </Grid>
</UserControl>
